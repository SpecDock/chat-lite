NODE_ENV=production
PORT=3000
APP_ORIGIN=https://chat.zzxandyl.cn
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/app.db
SESSION_COOKIE_NAME=chat_lite_session
SESSION_TTL_DAYS=30
INVITE_CODE=change-me-to-a-private-invite-code
MAX_UPLOAD_MB=5

# LangChain single-model agent over OpenAI-compatible chat API
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.3

# Optional lightweight title generation model. Falls back to MODEL_* when empty.
TITLE_API_KEY=
TITLE_BASE_URL=
TITLE_MODEL_NAME=
TITLE_MODEL_TEMPERATURE=0.2

# Backward-compatible aliases. Prefer MODEL_* above.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Text-to-image API. Supports OpenAI-compatible /images/generations responses with url or b64_json.
TEXT_IMAGE_API_URL=https://api.openai.com/v1
TEXT_IMAGE_API_KEY=
TEXT_IMAGE_MODEL=

# Image-to-image/edit API. Can use a different vendor/key/model from text-to-image.
# MiniMax uses JSON subject_reference at /v1/image_generation, not OpenAI multipart /images/edits.
IMAGE_EDIT_API_URL=https://api.minimaxi.com/v1/image_generation
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=image-01
IMAGE_EDIT_SOURCE_MODE=base64
IMAGE_EDIT_REFERENCE_TYPE=character
IMAGE_ASPECT_RATIO=1:1
IMAGE_RESPONSE_FORMAT=url

# Backward-compatible image aliases. Prefer TEXT_IMAGE_* and IMAGE_EDIT_* above.
IMAGE_API_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_SIZE=1024x1024

# Optional SMTP. In development, missing SMTP logs email codes to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_SERVERNAME=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chat Lite <no-reply@example.com>"

# MiniMax MCP stdio server settings
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MCP_COMMAND=uvx
MINIMAX_MCP_ARGS=minimax-coding-plan-mcp -y
MINIMAX_MCP_BASE_PATH=./data
