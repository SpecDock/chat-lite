NODE_ENV=production
PORT=3000
APP_ORIGIN=https://chat.zzxandyl.cn
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DATABASE_PATH=./data/app.db
SESSION_COOKIE_NAME=chat_lite_session
SESSION_TTL_DAYS=30
INVITE_CODE=welcome-chat-lite-specdock-zzx
MAX_UPLOAD_MB=5

# Agent tool-call budget. Private-use defaults are intentionally relaxed.
AGENT_RECURSION_LIMIT=30
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_WEB_SEARCH_CALLS=5
AGENT_MAX_IMAGE_UNDERSTAND_CALLS=5
AGENT_MAX_IMAGE_GENERATION_CALLS=1
AGENT_MAX_IMAGE_TO_IMAGE_CALLS=10

# Chat context window sizes (message count, user+assistant combined)
ANSWER_HISTORY_LIMIT=20
ROUTER_HISTORY_LIMIT=16

# LangChain single-model agent over OpenAI-compatible chat API
MODEL_API_KEY=
MODEL_BASE_URL=https://aicodelink.top/v1
MODEL_NAME=gpt-5.5 
MODEL_TEMPERATURE=0.3

# Optional lightweight title generation model. Falls back to MODEL_* when empty.
TITLE_API_KEY=
TITLE_BASE_URL=https://api.deepseek.com/v1
TITLE_MODEL_NAME=deepseek-v4-flash
TITLE_MODEL_TEMPERATURE=0.2


# Backward-compatible aliases. Prefer MODEL_* above.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aicodelink.top/v1p
OPENAI_MODEL=gpt-5.5

# Text-to-image API. Supports OpenAI-compatible /images/generations responses with url or b64_json.
TEXT_IMAGE_API_URL=https://colorflowai.com/v1/images/generations
TEXT_IMAGE_API_KEY=
TEXT_IMAGE_MODEL=gpt-image-2

# Image-to-image/edit API. Can use a different vendor/key/model from text-to-image.
IMAGE_EDIT_API_URL=https://colorflowai.com/v1/images/edits
IMAGE_EDIT_API_KEY=
IMAGE_EDIT_MODEL=gpt-image-2
IMAGE_EDIT_SOURCE_MODE=multipart
IMAGE_EDIT_REFERENCE_TYPE=character
IMAGE_ASPECT_RATIO=1:1
IMAGE_RESPONSE_FORMAT=url

# Optional image generation endpoint placeholder
IMAGE_API_URL=https://aicodelink.top/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024

# ========================================================
# 生产环境 SMTP 邮件服务配置 (已接入 Google Gmail)
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                                          # 采用 STARTTLS 显式加密协议
SMTP_USER=2928781682zzx@gmail.com                         # 替换为您的真实 Gmail 地址
SMTP_PASS=                        # 替换为 Google 生成的 16 位应用专用密码（去掉空格）
SMTP_FROM="Chat Lite <2928781682zzx@gmail.com>"          # 发件人别名，注意：邮箱必须与 SMTP_USER 一致，否则会被 Google 拒绝投递

# MiniMax MCP stdio server settings
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_MCP_COMMAND=uvx
MINIMAX_MCP_ARGS=minimax-coding-plan-mcp -y
MINIMAX_MCP_BASE_PATH=./data

# ========================================================
# RAG (lightweight retrieval-augmented generation)
# ========================================================
RAG_WRITE_ENABLED=false
RAG_READ_ENABLED=false
RAG_SHADOW_ENABLED=false
RAG_TOP_K=3
RAG_CURRENT_CONVERSATION_BOOST=0.15
RAG_CONTENT_MAX_CHARS=1200
RAG_CHUNK_ENABLED=true
RAG_CHUNK_MAX_CHARS=1200
RAG_DATABASE_PATH=./data/rag.db
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_MODEL_API_KEY=
RAG_CHUNK_MODEL_BASE_URL=
RAG_CHUNK_MODEL_NAME=
RAG_CHUNK_MODEL_TEMPERATURE=0.1
RAG_BACKFILL_BATCH_SIZE=50
RAG_BACKFILL_DELAY_MS=1000
