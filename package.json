{
  "name": "chat-lite",
  "version": "0.1.0",
  "description": "Lightweight mobile chat app with React/Vite frontend and native Node.js HTTP TypeScript backend.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external && esbuild src/server/application/rag/backfill.ts --bundle --platform=node --format=esm --outfile=dist-server/backfill-rag.js --packages=external && node scripts/copy-schema.mjs",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "rag:backfill": "node dist-server/backfill-rag.js"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@langchain/core": "^1.1.48",
    "@langchain/openai": "^1.4.7",
    "@shikijs/stream": "4.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "argon2": "0.45.1",
    "better-sqlite3": "12.11.1",
    "busboy": "^1.6.0",
    "dompurify": "^3.4.9",
    "dotenv": "^16.4.7",
    "gsap": "^3.15.0",
    "langchain": "^1.4.4",
    "lucide-react": "^1.25.0",
    "markdown-it": "^14.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.3.1",
    "sqlite-vec": "0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/busboy": "^1.5.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
